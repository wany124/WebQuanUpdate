# Copy this file to .env and fill in real values for local development.
# This project does not auto-load .env files (no dotenv dependency), so
# export these variables into your shell before running npm scripts, e.g.:
#   export $(grep -v '^#' .env | xargs)

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webquan

# Used to sign/encrypt session cookies (required, use a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Required by server/objectStorage.ts. In production on Replit this is
# provisioned automatically. For local development, image/PDF uploads will
# not work unless this service is reimplemented for a non-Replit storage
# backend (e.g. S3, GCS with a real service account, or local disk).
DEFAULT_OBJECT_STORAGE_BUCKET_ID=local-dev-bucket

# Port the app listens on (defaults to 5000)
PORT=5000

NODE_ENV=development
