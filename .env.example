# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --- Database (required) ---
# Local dev example:
#   DATABASE_URL=postgresql://webquan:password@localhost:5432/webquan_dev
# Hosted provider example (Render/Railway/Neon/Supabase all give you one of these):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Set to "true"/"false" to force SSL on/off for the DB connection.
# If unset, SSL is automatically enabled when NODE_ENV=production and
# disabled otherwise (see server/db.ts). Most managed Postgres providers
# require SSL.
# PGSSL=true

# --- Session (required) ---
# Generate a strong random value, e.g.: openssl rand -base64 32
SESSION_SECRET=

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Initial admin account (used by scripts/init-admin.ts) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- File uploads ---
# By default, uploaded images/PDFs are written to the local ./uploads
# folder and served from /uploads/*. This works fine as long as the
# host provides a PERSISTENT disk/volume mounted at ./uploads.
#
# For hosts with ephemeral disks (most autoscaling/serverless-style
# platforms), set S3_BUCKET below to instead store uploads in S3 or any
# S3-compatible service (Cloudflare R2, Backblaze B2, MinIO, etc.).
# When S3_BUCKET is set, all NEW uploads go to object storage
# automatically; existing local files are left alone until you run
# `npm run migrate:uploads` (see scripts/migrate-uploads-to-s3.ts).

# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible services (R2, MinIO, etc.)
# S3_ENDPOINT=
# Public base URL to prefix onto object keys, if your bucket/CDN needs
# a specific domain (e.g. https://pub-xxxxxxxx.r2.dev or a CloudFront domain).
# If unset, falls back to the endpoint (if set) or the AWS S3 virtual-hosted URL.
# S3_PUBLIC_URL_BASE=
